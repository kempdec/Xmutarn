{
  "name": "xmutarn",
  "version": "0.29.0-beta",
  "homepage": "https://viniciusxdl.github.io/xmutarn",
  "description": "Xmutarn é um framework front-end criado com a finalidade de facilitar e aumentar a produtividade na construção de páginas modernas e estilosas.",
  "author": {
    "name": "Vinícius Lima",
    "email": "viniciusxdl@outlook.com",
    "url": "https://github.com/viniciusxdl"
  },
  "main": "dist/js/xmutarn.js",
  "style": "dist/css/xmutarn.css",
  "sass": "src/scss/xmutarn.scss",
  "types": "src/ts/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/viniciusxdl/xmutarn.git"
  },
  "bugs": {
    "url": "https://github.com/viniciusxdl/xmutarn/issues"
  },
  "files": [
    "dist/{css,fonts,js}/**/*.{css,js,map,woff2}",
    "src/{scss,ts}/*.{scss,ts}",
    "gulpfile.ts",
    "tsconfig.json",
    "yarn.lock"
  ],
  "scripts": {
    "test": "bundlesize"
  },
  "bundlesize": [
    {
      "path": "./dist/css/xmutarn.css",
      "maxSize": "25 kB"
    },
    {
      "path": "./dist/css/xmutarn.min.css",
      "maxSize": "23 kB"
    },
    {
      "path": "./dist/js/xmutarn.js",
      "maxSize": "29 kB"
    },
    {
      "path": "./dist/js/xmutarn.min.js",
      "maxSize": "17.5 kB"
    }
  ],
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "@types/browserify": "^12.0.36",
    "@types/gulp": "^4.0.7",
    "@types/gulp-autoprefixer": "^0.0.32",
    "@types/gulp-header": "^2.0.0",
    "@types/gulp-rename": "^0.0.33",
    "@types/gulp-sass": "^4.0.0",
    "@types/gulp-sourcemaps": "^0.0.32",
    "@types/gulp-terser": "^1.2.1",
    "@types/vinyl-buffer": "^1.0.0",
    "@types/vinyl-source-stream": "^0.0.30",
    "browserify": "^16.5.2",
    "del": "^6.0.0",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^6.1.0",
    "gulp-header": "^2.0.9",
    "gulp-pug": "^4.0.1",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^4.0.2",
    "gulp-sourcemaps": "^2.6.5",
    "gulp-terser": "^1.4.0",
    "gulp-typescript": "^6.0.0-alpha.1",
    "gulp-watch": "^5.0.1",
    "merge-stream": "^1.0.1",
    "ts-node": "^9.0.0",
    "tsify": "^5.0.2",
    "typescript": "^4.0.3",
    "vinyl-buffer": "^1.0.1",
    "vinyl-source-stream": "^2.0.0"
  }
}
