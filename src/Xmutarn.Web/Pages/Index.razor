@page "/"
@using Xmutarn.Web.Resources.Pages

<main style="text-align: center;">
    <header>
        <figure>
            <img src="img/logo.png" alt="@IndexResource.LogoAlt">
        </figure>

        <h1>
            @AppResource.Name
        </h1>

        <p>
            @AppResource.Summary
        </p>
    </header>
</main>

<footer style="text-align: center;">
    2016-@DateTime.Now.Year &copy; KempDec Brasil Ltda.
</footer>