@page "/"
@using Xmutarn.Web.Resources.Pages

<main>
    <section class="theme-bg-to-bottom fg-white" style="height: 100dvh;">
        <div class="container height-100">
            <header class="flex-row flex-content-center flex-items-center height-100">
                <div class="flex-col-12 flex-col-6__lg padding-xl">
                    <figure class="padding-y-md typo-align-center">
                        <img class="max-width-100" src="img/logo.png" alt="@IndexResource.LogoAlt">
                    </figure>

                    <div class="typo-align-center">
                        <h1 class="typo-h2 typo-weight-regular margin-y-0 padding-y-md">
                            @AppResource.Name
                        </h1>

                        <p class="typo-h5 margin-y-0 padding-y-md" style="opacity: .8;">
                            @AppResource.Summary
                        </p>

                        <a class="btn btn_size-xl bg-black margin-y-md" href="@AppRoute.Docs.Introduction()" style="opacity: .8;">
                            @IndexResource.Start
                        </a>
                    </div>
                </div>
            </header>
        </div>
    </section>
</main>

<Footer />