extends ../../includes/_layout.pug

block variables
  - const appBaseAddress = "../../";

block pageTitle
  title Inputs • #{appName}

block content
  main.container
    .flex-row
      .flex-col-10__lg.margin-x-auto
        header.typo-align-center.typo-align-left__sm
          h1.typo-h2.theme-fg-500
            | Inputs
          p.typo-h5.typo-weight-light
            | Crie seus formulários rapidamente.
          .border-divider

        section.typo-body-1
          h2.typo-h3
            | Básico
          p
            | Os input podem ser criado com o uso do prefixo
            |
            code
              | input
            | . Veja como criar um campo de input abaixo.

          .card.display-flex(style="flex-wrap: wrap;")
            header.card--header.flex-col-12
              h1.card--header--title.typo-subtitle-2
                | Exemplo
            .flex-col-4__md.flex-col-3__xl.padding-md
              .input
                input.input--field(placeholder="Default")
            .flex-col-4__md.flex-col-3__xl.padding-md
              .input
                input.input--field.input--field_outlined(placeholder="Outlined")
          pre.theme-bg-card
            code.language-html
              | &lt;div class="input">
              |    &lt;input class="input--field" placeholder="Default">
              | &lt;/div>
              |
              | &lt;div class="input">
              |    &lt;input class="input--field input--field_outlined" placeholder="Outlined">
              | &lt;/div>

          h2.typo-h3
            | Rótulos ativos
          p
            | Também é possível adicionar pequenos rótulos ativos para seus input. Eles devem vir depois dos campos (
            code
              | .input--field
            | ), como no exemplo abaixo.

          .card.display-flex(style="flex-wrap: wrap;")
            header.card--header.flex-col-12
              h1.card--header--title.typo-subtitle-2
                | Exemplo
            .flex-col-4__md.flex-col-3__xl.padding-md
              .input
                input.input--field
                label.input--label.input--label_active
                  | Default
            .flex-col-4__md.flex-col-3__xl.padding-md
              .input
                input.input--field.input--field_outlined
                label.input--label.input--label_active
                  | Outlined
          pre.theme-bg-card
            code.language-html
              | &lt;div class="input">
              |     &lt;input class="input--field">
              |     &lt;label class="input--label input--label_active">
              |         Default
              |     &lt;/label>
              | &lt;/div>
              |
              | &lt;div class="input">
              |     &lt;input class="input--field input--field_outlined">
              |     &lt;label class="input--label input--label_active">
              |         Outlined
              |     &lt;/label>
              | &lt;/div>

          h2.typo-h3
            | Descrição
          p
            | Adicione uma descrição para informar o usuário final.

          .card.display-flex(style="flex-wrap: wrap;")
            header.card--header.flex-col-12
              h1.card--header--title.typo-subtitle-2
                | Exemplo
            .flex-col-4__md.flex-col-3__xl.padding-md
              .input
                .input
                input.input--field(placeholder="Default")
                p.input--description
                  | Uma descrição qualquer.
            .flex-col-4__md.flex-col-3__xl.padding-md
              .input
                input.input--field.input--field_outlined(placeholder="Outlined")
                p.input--description
                  | Uma descrição qualquer.
          pre.theme-bg-card
            code.language-html
              | &lt;div class="input">
              |     &lt;input class="input--field" placeholder="Default">
              |     &lt;p class="input--description">
              |         Uma descrição qualquer.
              |     &lt;/p>
              | &lt;/div>
              |
              | &lt;div class="input">
              |     &lt;input class="input--field input--field_outlined" placeholder="Outlined">
              |     &lt;p class="input--description">
              |         Uma descrição qualquer.
              |     &lt;/p>
              | &lt;/div>

          h2.typo-h3
            | Cores
          p
            | As cores podem ser usadas pra destacar um input.

          .card.display-flex(style="flex-wrap: wrap;")
            header.card--header.flex-col-12
              h1.card--header--title.typo-subtitle-2
                | Exemplo
            .flex-col-4__md.flex-col-3__xl.padding-md
              .input.input_color-alert
                input.input--field(placeholder="Alert")
            .flex-col-4__md.flex-col-3__xl.padding-md
              .input.input_color-warning
                input.input--field(placeholder="Warning")
                p.input--description
                  | Uma descrição de atenção.
            .flex-col-4__md.flex-col-3__xl.padding-md
              .input.input_color-success
                input.input--field.input--field_outlined(placeholder="Success")
                p.input--description
                  | Uma descrição de sucesso.
          pre.theme-bg-card
            code.language-html
              | &lt;div class="input input_color-alert">
              |     &lt;input class="input--field" placeholder="Alert">
              | &lt;/div>
              |
              | &lt;div class="input input_color-warning">
              |     &lt;input class="input--field" placeholder="Warning">
              |     &lt;p class="input--description">
              |         Uma descrição de atenção.
              |     &lt;/p>
              | &lt;/div>
              |
              | &lt;div class="input input_color-success">
              |     &lt;input class="input--field input--field_outlined" placeholder="Success">
              |     &lt;p class="input--description">
              |         Uma descrição de sucesso.
              |     &lt;/p>
              | &lt;/div>

          h2.typo-h3
            | Instância a partir do HTML
          p
            | Você pode criar uma instância simples a partir do HTML com o atributo
            |
            code
              | x-input
            |
            | e obter alguns recursos extras, como um rôtulo que alterna entre ativado e desativado.
          p
            | Clique dentro do campo para ver a transição.

          .card.display-flex(style="flex-wrap: wrap;")
            header.card--header.flex-col-12
              h1.card--header--title.typo-subtitle-2
                | Exemplo
            .flex-col-4__md.flex-col-3__xl.padding-md
              .input(x-input x-input-label="Default")
                input.input--field
            .flex-col-4__md.flex-col-3__xl.padding-md
              .input(x-input x-input-label="Outlined")
                input.input--field.input--field_outlined
          pre.theme-bg-card
            code.language-html
              | &lt;div class="input" x-input x-input-label="Default">
              |     &lt;input class="input--field">
              | &lt;/div>
              |
              | &lt;div class="input" x-input x-input-label="Outlined">
              |     &lt;input class="input--field input--field_outlined">
              | &lt;/div>

          h2.typo-h3
            | Instância em ES
          p
            | Uma instância em EcmaScript pode ser criada, caso queira ter mais controle sobre o componente.
          pre.theme-bg-card
            code.language-html
              | &lt;div id="i-input-example" class="input">
              |     &lt;input class="input--field">
              | &lt;/div>
          pre.theme-bg-card
            code.language-javascript
              | const inputElement = document.getElementById("i-input-example");
              | const input = new X.InputComponent(inputElement);
