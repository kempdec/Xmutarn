include _app-settings.pug

block variables

doctype html
html(lang="pt-br" prefix="og: http://ogp.me/ns#")

  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
    meta(name="description" content=appDescription)

    meta(name="theme-color" content="#7B1FA2")

    //- Integração com ambiente ~ OpenGraph.
    meta(property="og:title" content="Xmutarn")
    meta(property="og:type" content="website")
    meta(property="og:url" content=appAddress)
    meta(property="og:image" content=`${appAddress}/assets/img/environment/opengraph.png`)
    meta(property="og:description" content=appDescription)
    meta(property="og:site_name" content=appName)

    //- Integração com ambiente ~ Twitter.
    meta(name="twitter:image" content=`${appAddress}/assets/img/environment/twitter.png`)

    block pageTitle
      title #{appName}

    base(href=appBaseAddress)

    link(rel="shortcut icon" href="assets/img/icon.png")
    link(rel="manifest" href="manifest.json")

    //- Arquivos de estilo.
    link(rel="stylesheet" href="assets/lib/xmutarn/css/xmutarn.min.css")
    link(rel="stylesheet" href="https://unpkg.com/prismjs@1.22.0/themes/prism-solarizedlight.css")

    block styles

  body.typo-use-default.theme-bg-background.theme-fg-primary

    //- Barra de ferramentas.
    header.toolbar(x-toolbar)
      nav.container-fluid
        .toolbar--nav
          button.toolbar--nav--item.cursor-pointer(x-listener-open-nav-drawer="i-doc-drawer")
            span.fas.fa-bars.fa-lg
          a.toolbar--nav--item.margin-right-sm.padding-xs(href="")
            img(src="assets/img/environment/manifest.png" alt="Logotipo do Xmutarn com fundo linear" style="max-height: 2.5rem;")
          a.toolbar--nav--item(href="")
            | Início
          a.toolbar--nav--item(href="docs/getting-started.html")
            | Documentação

        .toolbar--nav
          button#i-change-main-theme.toolbar--nav--item.cursor-pointer
            span.fas.fa-lightbulb.fa-lg
          a.toolbar--nav--item(href=appRepository target="_blank")
            span.toolbar--nav--item--icon.fab.fa-github.fa-lg
            | GitHub

    block content

    aside#i-doc-drawer.navigation-drawer(x-nav-drawer)
      nav.list.list_padded
        header
          h1.typo-h3.typo-weight-light.typo-align-center
            | Navegar
        .border-divider.margin-bottom-sm

        a.list--item(href="docs/getting-started.html")
          | Começando
        a.list--item(href="docs/introduction.html")
          | Introdução

        p.padding-x-md.typo-body-2.typo-weight-bold
          | Temas e cores
        a.list--item(href="docs/colors.html")
          | Cores
        a.list--item(href="docs/themes.html")
          | Temas

        p.padding-x-md.typo-body-2.typo-weight-bold
          | Componentes
        a.list--item(href="docs/components/inputs.html")
          | Inputs

    //- Arquivos de script.
    script(src="assets/lib/xmutarn/js/xmutarn.min.js")
    script(src="assets/lib/js-cookie/js.cookie.js")
    script(defer src="assets/js/shared/layout.min.js")
    script(defer src="https://use.fontawesome.com/releases/v5.4.1/js/all.js" integrity="sha384-L469/ELG4Bg9sDQbl0hvjMq8pOcqFgkSpwhwnslzvVVGpDjYJ6wJJyYjvG3u8XW7" crossorigin="anonymous")
    script(src="https://unpkg.com/prismjs@1.22.0/components/prism-core.min.js")
    script(src="https://unpkg.com/prismjs@1.22.0/plugins/autoloader/prism-autoloader.min.js")

    block scripts
