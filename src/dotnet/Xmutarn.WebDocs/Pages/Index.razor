@page "/"
@inject AppSettings AppSettings

<main>
    <section class="theme-bg-to-bottom fg-white">
        <div class="container padding-bottom-lg padding-bottom-xl__lg">
            <div class="flex-row flex-items-center">
                <figure class="flex-col-10 flex-col-8__sm flex-col-6__lg flex-order-1__lg margin-x-auto margin-top-sm margin-top-lg__xl">
                    <img class="max-width-100" src="img/xmutarn-logo-abstract.png" alt="Logotipo do Xmutarn com fundo abstrato.">
                </figure>

                <article class="flex-col-6__lg typo-align-center typo-align-left__lg">
                    <h1 class="typo-h2">
                        Xmutarn
                    </h1>
                    <p class="typo-h5" style="opacity: .8;">
                        Um framework front-end moderno e estiloso criado para a produtividade.
                    </p>

                    <NavLink class="btn btn_size-xl btn_color-accent typo-to-uppercase" href="docs/getting-started.html">
                        Começar
                    </NavLink>
                    <p class="typo-body-1">
                        Versão: 0.31.0
                    </p>
                </article>
            </div>
        </div>
    </section>

    <section class="padding-y-md padding-y-xl__xl theme-bg-background">
        <div class="container padding-y-md padding-y-lg__xl">
            <div class="flex-row">
                <article class="flex-col-4__lg">
                    <figure class="display-flex flex-content-center">
                        <span class="fas fa-code fa-4x theme-fg-A400"></span>
                    </figure>

                    <h1 class="typo-h5 typo-align-center">
                        Semântico
                    </h1>
                    <p class="typo-body-1 typo-align-center theme-fg-secondary">
                        Completamente semântico. Não sacrifique seu código para aplicar seu estilo.
                    </p>
                </article>

                <article class="flex-col-4__lg">
                    <figure class="display-flex flex-content-center">
                        <span class="fas fa-cubes fa-4x theme-fg-A400"></span>
                    </figure>

                    <h1 class="typo-h5 typo-align-center">
                        Fácil de usar, fácil de aprender
                    </h1>
                    <p class="typo-body-1 typo-align-center theme-fg-secondary">
                        Com padrões para diminuir a curva de aprendizado e a constante consulta na documentação.
                    </p>
                </article>

                <article class="flex-col-4__lg">
                    <figure class="display-flex flex-content-center">
                        <span class="fas fa-bolt fa-4x theme-fg-A400"></span>
                    </figure>

                    <h1 class="typo-h5 typo-align-center">
                        Produtivo
                    </h1>
                    <p class="typo-body-1 typo-align-center theme-fg-secondary">
                        Amamos a produtividade, assim como todos. "Snippets" hoje, "snippets" amanhã, "snippets" sempre.
                    </p>
                </article>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <div class="flex-row flex-items-center padding-md typo-caption-1">
                <NavLink class="margin-right-md" href="@AppSettings.GithubAddress" target="_blank">
                    GitHub
                </NavLink>
                <NavLink href="@($"{AppSettings.GithubAddress}/blob/main/LICENSE")" target="_blank">
                    MIT License
                </NavLink>
                <span class="margin-left-auto">
                    2018-@DateTime.Now.Year &copy; Vinícius Lima. Todos os direitos reservados.
                </span>
            </div>
        </div>
    </footer>
</main>
